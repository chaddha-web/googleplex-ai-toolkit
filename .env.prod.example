# ─── Production env (DO NOT COMMIT — copy to .env.prod on the box) ───
# Generate fresh secrets with: openssl rand -hex 32

# Domain
DOMAIN=ggakingclub.com
LETSENCRYPT_EMAIL=start@ggakingclub.com

# Auth service
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
RESEND_API_KEY=REPLACE_WITH_real_resend_key
RESEND_FROM=GoogolPlex <start@ggakingclub.com>
ADMIN_EMAILS=Chaddhafateh0@gmail.com

# Cross-service (auth ↔ wallet)
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# Wallet — chain RPCs
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Polygon — use the same Alchemy key as ETH (one app per network) so the
# deposit indexer can use alchemy_getAssetTransfers for full history.
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=
BTC_API_URL=https://mempool.space/api

# Wallet — AWS KMS for master-seed envelope encryption
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KMS_KEY_ID=

# Wallet — master xpubs (populate from `npm run init-seeds` output)
EVM_MASTER_XPUB=
BTC_MASTER_XPUB=
TRON_MASTER_XPUB=

# Wallet — JIT cache
REFRESH_CACHE_TTL_SECONDS=30

# Sentry (optional; leave blank to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Geo — precise IP location for the admin session "Area" column and
# login-location alerts (ip2location.io). Optional: if unset or failing, the
# service falls back to the bundled offline geoip-lite database.
# NOTE: with this set, member IPs are sent to a third party for those two
# surfaces. The admin globe stays fully offline either way.
IP2LOCATION_API_KEY=
IP2LOCATION_TIMEOUT_MS=3000

# ── Admin media uploads (orientation video, dashboard background) ──────────
# Written by the auth service into the shared ./media volume and served by the
# nginx `media` container. Both are set in docker-compose.prod.yml; only the
# size cap is worth tuning here. Default 512MB — a 10-minute 1080p MP4 is
# usually 150-400MB, so lower this if the VPS disk is tight.
# MEDIA_MAX_BYTES=536870912

# Bot handle (no @) shown to admins linking their Telegram in Admin -> Alerts.
# Without it the setup steps still work, but the bot link isn't clickable.
TELEGRAM_BOT_USERNAME=

# ── Alchemy JWT auth (optional hardening) ─────────────────────────────────
# With these set, RPC requests carry a short-lived RS256 token instead of
# relying on the API key in the URL — so a leaked URL is useless on its own.
# Generate the keypair ON THE SERVER (never paste a private key anywhere):
#   openssl genrsa -out /data/alchemy-jwt.key 2048
#   openssl rsa -in /data/alchemy-jwt.key -pubout -outform DER | base64 -w0
# Upload that public key in Alchemy -> your app -> Security -> Import Public
# Key, then put the kid it returns here. Unset = plain API-key auth, as before.
# ALCHEMY_JWT_KEY_FILE=/data/alchemy-jwt.key
# ALCHEMY_JWT_KID=
